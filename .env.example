# StockBallDB local configuration
# Copy to .env and fill in values. Never commit .env.

# Required for Phase 0 (PostgreSQL connection)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/stockballdb

# Separate disposable database for mutating pytest integration tests only.
# Must NOT be the same host/port/database as DATABASE_URL.
# Mutating tests never fall back to DATABASE_URL when this is unset (they skip).
STOCKBALLDB_TEST_DATABASE_URL=

# Provider credentials
# Required for V1 build (python -m stockballdb.build_v1):
TIINGO_API_KEY=
FRED_API_KEY=
# Unused in V1:
EIA_API_KEY=
